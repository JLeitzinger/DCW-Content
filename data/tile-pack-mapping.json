    { "match": "crystal_", "themeCategory": "alchemical" },
    { "match": "lab-", "themeCategory": "alchemical" },
    { "match": "crypt", "themeCategory": "undead" },
    { "match": "bone", "themeCategory": "undead" },
    { "match": "catacombs", "themeCategory": "undead" },
    { "match": "tomb", "themeCategory": "undead" },
    { "match": "ice", "themeCategory": "elemental" },
    { "match": "frozen", "themeCategory": "elemental" },
    { "match": "hell", "themeCategory": "elemental" },
    { "match": "infernal", "themeCategory": "elemental" },
    { "match": "lava", "themeCategory": "elemental" },
    { "match": "volcanic", "themeCategory": "elemental" },
    { "match": "church", "themeCategory": "cult" },
    { "match": "banners", "themeCategory": "cult" },
    { "match": "relief", "themeCategory": "cult" },
    { "match": "sigil", "themeCategory": "cult" },
    { "match": "cage", "themeCategory": "goblin_warren" },
    { "match": "mud", "themeCategory": "goblin_warren" },
    { "match": "grey_dirt", "themeCategory": "goblin_warren" },
    { "match": "pebble_brown", "themeCategory": "goblin_warren" },
    { "match": "green_bones", "themeCategory": "goblin_warren" },
    { "match": "dirt", "themeCategory": "feral" },
    { "match": "grass", "themeCategory": "feral" },
    { "match": "lair", "themeCategory": "feral" },
    { "match": "orc", "themeCategory": "feral" },
    { "match": "abyss", "themeCategory": "abyssal" },
    { "match": "demonic_red", "themeCategory": "abyssal" }
  ]
