{
  "name": "dcw-content",
  "version": "1.0.0",
  "description": "Content generation tools and compendium packs for Dungeon Crawler World",
  "scripts": {
    "generate:races": "node scripts/generate-races.mjs",
    "generate:classes": "node scripts/generate-classes.mjs",
    "generate:items": "node scripts/generate-items.mjs",
    "generate:weapons": "node scripts/generate-weapons.mjs",
    "generate:armor": "node scripts/generate-armor.mjs",
    "generate:features": "node scripts/generate-features.mjs",
    "generate:skills": "node scripts/generate-skills.mjs",
    "generate:spells": "node scripts/generate-spells.mjs",
    "generate:floors": "node scripts/generate-floors.mjs",
    "generate:monsters": "node scripts/generate-monsters.mjs",
    "generate": "npm run generate:races && npm run generate:classes && npm run generate:items && npm run generate:weapons && npm run generate:armor && npm run generate:features && npm run generate:skills && npm run generate:spells && npm run generate:monsters && npm run generate:floors",
    "validate": "node scripts/validate-content.mjs",
    "pack": "npm run validate && npm run pack:items && npm run pack:weapons && npm run pack:armor && npm run pack:skills && npm run pack:races && npm run pack:spells && npm run pack:features && npm run pack:classes && npm run pack:monsters && npm run pack:characters && npm run pack:scenes && npm run pack:journals",
    "pack:items": "node scripts/pack-items.mjs",
    "pack:weapons": "node scripts/pack-weapons.mjs",
    "pack:armor": "node scripts/pack-armor.mjs",
    "pack:skills": "node scripts/pack-skills.mjs",
    "pack:races": "node scripts/pack-races.mjs",
    "pack:spells": "node scripts/pack-spells.mjs",
    "pack:features": "node scripts/pack-features.mjs",
    "pack:classes": "node scripts/pack-classes.mjs",
    "pack:monsters": "node scripts/pack-monsters.mjs",
    "pack:characters": "node scripts/pack-characters.mjs",
    "pack:scenes": "node scripts/pack-scenes.mjs",
    "pack:journals": "node scripts/pack-journals.mjs",
    "add-skills-to-weapons": "node scripts/add-skills-to-weapons.mjs",
    "skill-lookup": "node scripts/skill-lookup.mjs",
    "spell-lookup": "node scripts/spell-lookup.mjs",
    "generate:icon-index": "node scripts/generate-icon-index.mjs",
    "inspect:skills": "node scripts/inspect-skills-db.mjs",
    "list:skills": "node scripts/list-all-skills-db.mjs",
    "build:release": "node scripts/build-release.mjs"
  },
  "keywords": [
    "foundry-vtt",
    "dungeon-crawler-world",
    "compendium",
    "content-tools"
  ],
  "author": "JLeitzinger",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JLeitzinger/DCW-Content"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "classic-level": "^3.0.0",
    "pngjs": "^7.0.0"
  }
}
